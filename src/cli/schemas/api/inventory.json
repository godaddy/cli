      "method": "GET",
      "path": "/v1/commerce/stores/{storeId}/inventory-summaries",
      "summary": "Get inventory summaries",
      "description": "This endpoint can be used to retrieve a list of all inventory summaries with detailed quantities within a specific store using the store ID.",
      "parameters": [
        {
          "name": "updatedAtStart",
          "in": "query",
          "required": false,
          "description": "Filter out summaries whose updatedAt timestamp falls strictly before the provided timestamp",
          "schema": {
            "$ref": "./common-types/v1/schemas/json/date-time.json"
          }
        },
        {
          "name": "updatedAtEnd",
          "in": "query",
          "required": false,
          "description": "Filter out summaries whose updatedAt timestamp falls strictly after the provided timestamp",
          "schema": {
            "$ref": "./common-types/v1/schemas/json/date-time.json"
          }
        },
        {
          "name": "productIds",
          "in": "query",
          "required": false,
          "description": "filter by productId (comma-separated)",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Inventory Summaries found",
          "schema": {
            "type": "object",
            "title": "InventorySummaries",
            "properties": {
              "inventorySummaries": {
                "type": "array",
                "items": {
                  "$ref": "./models/Summary.yaml"
                }
              }
            }
          }
        },
        "401": {
          "description": "See ./http/Error.yaml#/components/responses/401"
        },
        "500": {
          "description": "See ./http/Error.yaml#/components/responses/500"
        }
      },
      "scopes": []
    },
