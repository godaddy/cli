{
  "name": "invoices",
  "title": "Invoice Service",
  "description": "The Invoice Service provides a way for merchants to bill specific customers for a list of goods / services provided",
  "version": "1.0.0",
  "baseUrl": "https://api.godaddy.com",
  "endpoints": [
    {
      "operationId": "queryInvoices",
      "method": "GET",
      "path": "/v1/commerce/stores/{storeId}/invoices",
      "summary": "",
      "description": "Finds any invoices filtered by the passed in criteria",
      "parameters": [
        {
          "name": "storeId",
          "in": "path",
          "required": true,
          "description": "Store ID",
          "schema": {
            "$ref": "./models/Invoice.yaml#/properties/storeId"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "description": "A non-negative, non-zero integer indicating the maximum number of resouces to return at one time",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 25,
            "default": 25
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "description": "It is a non-negative, non-zero integer representing ordinal of the requested page in the results",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "default": 1
          }
        },
        {
          "name": "sortBy",
          "in": "query",
          "required": false,
          "description": "Sort the underlying invoices by the given key",
          "schema": {
            "type": "string",
            "description": "Key to sort invoices by",
            "enum": ["createdAt", "updatedAt", "executeAt", "executedAt"],
            "default": "createdAt"
          }
        },
        {
          "name": "sortOrder",
          "in": "query",
          "required": false,
          "description": "Sort direction",
          "schema": {
            "type": "string",
            "description": "Sort direction",
            "enum": ["ASC", "DESC"],
            "default": "ASC"
          }
        },
        {
          "name": "dateField",
          "in": "query",
          "required": false,
          "description": "Date field to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Date field",
            "enum": ["createdAt", "updatedAt", "executeAt", "executedAt"],
            "default": "createdAt"
          }
        },
        {
          "name": "dateFieldStart",
          "in": "query",
          "required": false,
          "description": "Grab invoices with their dateField => this datetime",
          "schema": {
            "description": "A date and time, in [Internet date and time format](https://tools.ietf.org/html/rfc3339#section-5.6). Note: The regular expression provides static schematic guidance but does not reject all invalid dates.",
            "type": "string",
            "minLength": 20,
            "maxLength": 64,
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])[T,t]([0-1][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        {
          "name": "dateFieldEnd",
          "in": "query",
          "required": false,
          "description": "Grab invoices with their dateField <= this datetime",
          "schema": {
            "description": "A date and time, in [Internet date and time format](https://tools.ietf.org/html/rfc3339#section-5.6). Note: The regular expression provides static schematic guidance but does not reject all invalid dates.",
            "type": "string",
            "minLength": 20,
            "maxLength": 64,
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])[T,t]([0-1][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        {
          "name": "description",
          "in": "query",
          "required": false,
          "description": "Description to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Description of the invoice",
            "example": "Invoice for 3 items"
          }
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "description": "Invoice statuses (comma separated)",
          "schema": {
            "type": "string",
            "description": "List of invoice statuses (comma separated)",
            "example": "PAID,NOT_PAID"
          }
        },
        {
          "name": "type",
          "in": "query",
          "required": false,
          "description": "Invoice types (comma separated)",
          "schema": {
            "type": "string",
            "description": "List of invoice types (comma separated)",
            "example": "REGULAR,CHARGE"
          }
        },
        {
          "name": "executionStatus",
          "in": "query",
          "required": false,
          "description": "Execution status",
          "schema": {
            "type": "string",
            "description": "Execution status",
            "example": "NOT_EXECUTED"
          }
        },
        {
          "name": "customerId",
          "in": "query",
          "required": false,
          "description": "Customer ID to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Customer ID",
            "example": "54ee725f-8dee-4b0f-908b-e0334e6628f5"
          }
        },
        {
          "name": "customInvoiceId",
          "in": "query",
          "required": false,
          "description": "Custom invoice ID to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Custom invoice ID",
            "example": "3"
          }
        },
        {
          "name": "firstName",
          "in": "query",
          "required": false,
          "description": "First name to filter invoices by",
          "schema": {
            "type": "string",
            "description": "First name of the invoice customer",
            "example": "Dirk"
          }
        },
        {
          "name": "lastName",
          "in": "query",
          "required": false,
          "description": "Last name to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Last name of the invoice customer",
            "example": "Nowwitzki"
          }
        },
        {
          "name": "email",
          "in": "query",
          "required": false,
          "description": "Invoice email to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Email address of the invoice customer",
            "example": "dirk-nowitzki@gmail.com"
          }
        },
        {
          "name": "phone",
          "in": "query",
          "required": false,
          "description": "Invoice phone to filter invoices by",
          "schema": {
            "type": "string",
            "description": "Phone address of the invoice customer",
            "example": "4803663549"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successfully listed invoices",
          "schema": {
            "type": "object",
            "required": ["items", "links"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Invoice"
                }
              },
              "links": {
                "type": "array",
                "description": "Array containing one or more HATEOAS link relations that are relevant for traversing invoices",
                "items": {
                  "title": "Link Description",
                  "type": "object",
                  "description": "A request-related [HATEOAS link](https://datatracker.ietf.org/doc/html/draft-handrews-json-schema-hyperschema-02).",
                  "properties": {
                    "href": {
                      "description": "The complete target URL, or link, to use in combination with the method to make the related call, as defined by [RFC 6570 - URI Template](https://tools.ietf.org/html/rfc6570), with the addition of the `$`, `(`, and `)` characters for pre-processing. The `href` is the key HATEOAS component that links a completed call with a subsequent call.",
                      "type": "string",
                      "format": "uri"
                    },
                    "rel": {
                      "description": "The [link relation type](https://tools.ietf.org/html/rfc5988#section-4), which is an identifier for a link that unambiguously describes the semantics of the link. For values, see [Link Relationship Types](https://www.iana.org/assignments/link-relations/link-relations.xhtml).",
                      "type": "string"
                    },
                    "title": {
                      "description": "The link title.",
                      "type": "string"
                    },
                    "targetMediaType": {
                      "description": "The [RFC 2046-defined media type](https://www.ietf.org/rfc/rfc2046.txt) that describes the link target.",
                      "type": "string"
                    },
                    "targetSchema": {
                      "description": "The schema that describes the link target."
                    },
                    "method": {
                      "description": "The method to use to request the link target. For example, for HTTP, this might be `GET` or `DELETE`.",
                      "type": "string"
                    },
                    "submissionMediaType": {
                      "description": "The media type with which to submit data with the request.",
                      "type": "string",
                      "default": "application/json"
                    },
                    "submissionSchema": {
                      "description": "The schema that describes the request data."
                    }
                  },
                  "required": ["rel", "href"]
                }
              }
            }
          }
        },
        "400": {
          "description": "Bad Request Error",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "401": {
          "description": "Unauthorized Error",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "403": {
          "description": "Authentication Client Error",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "404": {
          "description": "Resource Not Found",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "500": {
          "description": "Internal server error",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "502": {
          "description": "Bad gateway or failed dependency",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "503": {
          "description": "Service is temporarily unavailable",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "504": {
          "description": "Gateway or dependency timeout",
          "schema": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "scopes": ["commerce.invoice:read"]
