      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": {
          "items": {
            "$ref": "./common-types/v1/schemas/yaml/patch-request.yaml"
          },
          "type": "array"
        }
      },
      "responses": {
        "200": {
          "description": "Subscription updated",
          "schema": {
            "$ref": "./models/Subscription.yaml"
          }
        },
        "404": {
          "description": "Subscription Not Found"
        },
        "default": {
