      "description": "Gets all applicable price adjustments for a given storeId",
      "parameters": [
        {
          "name": "storeId",
          "in": "path",
          "required": true,
          "description": "Store ID",
          "schema": {
            "type": "string",
            "description": "The storeId that this price adjustment belongs to",
            "readOnly": true,
            "format": "uuid"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "./models/PriceAdjustment.yaml"
            }
          }
        },
        "401": {
          "description": "See #/components/responses/UnauthorizedError"
        },
        "403": {
          "description": "See #/components/responses/AuthenticationError"
        },
