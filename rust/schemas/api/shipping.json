{
  "$defs": {
    "Address": {
      "$id": "https://godaddy.com/schemas/commerce/shipments/address.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Shipping address",
      "properties": {
        "addressLine1": {
          "description": "Address",
          "type": "string"
        },
        "addressLine2": {
          "description": "Address",
          "type": "string"
        },
        "addressLine3": {
          "description": "Address",
          "type": "string"
        },
        "city": {
          "description": "City",
          "type": "string"
        },
        "country": {
          "description": "Country",
          "type": "string"
        },
        "email": {
          "description": "Email address",
          "format": "email",
          "type": "string"
        },
        "instructions": {
          "description": "Instructions",
          "type": "string"
        },
        "isResidential": {
          "description": "Boolean",
          "type": "boolean"
        },
        "name": {
          "description": "Name",
          "type": "string"
        },
        "phone": {
          "description": "Phone number",
          "type": "string"
        },
        "postalCode": {
          "description": "Postal code",
          "type": "string"
        },
        "state": {
          "description": "State",
          "type": "string"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "AdvancedOption": {
      "$id": "https://godaddy.com/schemas/commerce/shipments/advanced-option.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "These are options that are provided by the carrier that can be selected when creating a shipment.",
      "properties": {
        "allowedValues": {
          "description": "Allowed values for the advanced option.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "defaultValue": {
          "description": "The default value of the advanced option.",
          "type": "string"
        },
        "name": {
          "description": "The name of the advanced option.",
          "type": "string"
        },
        "optionDescription": {
          "description": "The description of the advanced option.",
          "type": "string"
        },
        "optionType": {
          "description": "The type of the advanced option.",
          "type": "string"
        },
        "required": {
          "description": "Indicates if the advanced option is required.",
          "type": "boolean"
        }
      },
      "title": "Advanced Option",
      "type": "object"
    },
    "AdvancedShipmentOption": {
      "$id": "https://godaddy.com/schemas/commerce/shipments/advanced-shipment-option.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "These are the advanced carrier options that were selected when creating a shipment.",
      "properties": {
        "name": {
          "description": "The name of the advanced option.",
          "type": "string"
        },
        "value": {
          "description": "The value selected for the advanced option.",
          "type": "string"
        }
      },
      "title": "Advanced Shipment Option",
      "type": "object"
    },
    "Carrier": {
      "$id": "https://godaddy.com/schemas/commerce/shipments/carrier.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A carrier is a company that provides shipping services. ie. UPS, FedEx, USPS",
      "properties": {
        "advancedOptions": {
          "description": "Advanced options provided by the carrier which can be selected when creating a shipment.",
          "items": {
            "$ref": "#/$defs/AdvancedOption"
          },
          "type": "array"
        },
        "carrierCode": {
          "description": "A code used by the shipping provider to identify the carrier.",
          "type": "string"
        },
        "carrierName": {
          "description": "Used as the display name for the carrier.",
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/date-time"
        },
        "id": {
          "description": "An identifier unique to the carrier (Carrier_<KSUID>). Auto-generated by the service on creation",
          "readOnly": true,
          "type": "string"
        },
        "labelValidationRules": {
          "description": "Validation rules used when creating a label with the carrier.",
          "items": {
            "$ref": "#/$defs/ShippingValidationRule"
          },
          "type": "array"
        },
        "providerId": {
          "description": "The unique identifier for the commerce shipping provider that the carrier belongs to.",
          "type": "string"
        },
        "rateValidationRules": {
          "description": "Validation rules used when getting rates with the carrier.",
          "items": {
            "$ref": "#/$defs/ShippingValidationRule"
          },
          "type": "array"
        },
        "shipmentValidationRules": {
          "description": "Validation rules used when creating a shipment with the carrier.",
          "items": {
            "$ref": "#/$defs/ShippingValidationRule"
          },
          "type": "array"
        },
        "updatedAt": {
          "$ref": "#/$defs/date-time"
        }
      },
      "required": [
        "providerId",
        "carrierName",
        "carrierCode"
      ],
      "title": "Carrier",
      "type": "object"
    },
    "Error": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "fields": {
          "description": "List of the specific fields, and the errors found with their contents",
          "items": {
            "properties": {
              "code": {
                "$ref": "#/$defs/ErrorCode"
              },
              "message": {
                "$ref": "#/$defs/ErrorMessage"
              },
              "path": {
                "description": "1) JSONPath referring to the field within the data containing an error or 2) JSONPath referring to an object containing an error",
                "example": "JSONPath",
                "format": "json-path",
                "type": "string"
              },
              "pathRelated": {
                "description": "JSONPath referring to the field on the object referenced by `path` containing an error",
                "example": "JSONPath",
                "format": "json-path",
                "type": "string"
              }
            },
            "required": [
              "path",
              "code"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "message": {
          "$ref": "#/$defs/ErrorMessage"
        },
        "stack": {
          "description": "Stack trace indicating where the error occurred. NOTE: This attribute MAY be included for Development and Test environments. However, it MUST NOT be exposed from OTE nor Production systems",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Short identifier for the error, suitable for indicating the specific error within client code",
      "format": "error-code",
      "pattern": "^[A-Z_][A-Z0-9_]*$",
      "type": "string"
    },
    "ErrorMessage": {
      "description": "Human-readable, English description of the error",
      "type": "string"
    },
    "Shipment": {
      "$id": "https://godaddy.com/schemas/commerce/shipments/shipment.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A shipment contains all of the information needed to ship items to a customer.",
      "properties": {
        "advancedOptions": {
          "description": "Advanced options selected for the shipment. The possible options are stored in the carrier advanced options.",
          "items": {
            "$ref": "#/$defs/AdvancedShipmentOption"
          },
          "type": "array"
        },
        "confirmation": {
          "description": "The confirmation type",
          "enum": [
            "none",
            "delivery",
            "signature"
          ],
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/date-time"
        },
        "fulfillmentId": {
          "description": "The unique identifier for the commerce fulfillment.",
          "type": "string"
        },
        "id": {
          "description": "An identifier unique to the shipment (Shipment_<KSUID>). Auto-generated by the service on creation",
          "readOnly": true,
          "type": "string"
        },
        "isInternational": {
          "description": "Indicates if the shipment is international",
          "type": "boolean"
        },
        "isReturnLabel": {
          "description": "Indicates if the shipment is a return label",
          "type": "boolean"
        },
        "orderId": {
          "description": "ID associated with the commerce order.",
          "type": "string"
        },
        "packages": {
          "description": "The packages in the shipment",
          "items": {
            "properties": {
              "dimensions": {
                "properties": {
                  "height": {
                    "description": "The height value",
                    "type": "number"
                  },
                  "length": {
                    "description": "The length value",
                    "type": "number"
                  },
                  "units": {
                    "description": "The dimension units",
                    "enum": [
                      "inches",
                      "centimeters"
                    ],
                    "type": "string"
                  },
                  "width": {
                    "description": "The width value",
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "packageCode": {
                "description": "Package code",
                "type": "string"
              },
              "products": {
                "items": {
                  "properties": {
                    "name": {
                      "description": "The name of the product",
                      "type": "string"
                    },
                    "productId": {
                      "description": "The unique identifier for the product",
                      "type": "string"
                    },
                    "quantity": {
                      "description": "The quantity of the product in the package",
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "weight": {
                "properties": {
                  "units": {
                    "description": "The weight units",
                    "enum": [
                      "ounces",
                      "pounds",
                      "grams",
                      "kilograms"
                    ],
                    "type": "string"
                  },
                  "value": {
                    "description": "The weight value",
                    "type": "number"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "providerId": {
          "description": "The unique identifier for the commerce shipping provider.",
          "type": "string"
        },
        "shipDate": {
          "$ref": "#/$defs/date-time"
        },
        "shipFrom": {
          "$ref": "#/$defs/Address"
        },
        "shipTo": {
          "$ref": "#/$defs/Address"
        },
        "updatedAt": {
          "$ref": "#/$defs/date-time"
        }
      },
      "required": [
        "providerId",
        "fulfillmentId",
        "orderId",
        "shipFrom",
        "shipTo",
        "packages",
        "confirmation",
        "shipDate",
        "isReturnLabel",
        "isInternational"
      ],
      "title": "Shipment",
      "type": "object"
    },
    "ShippingValidationRule": {
      "$id": "https://godaddy.com/schemas/commerce/shipments/shipping-validation-rule.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Custom validation rules for the carrier.",
      "properties": {
        "field": {
          "description": "The field that the validation rule applies to. Should be in dot notation. ie 'shipTo.city'",
          "type": "string"
        },
        "ruleType": {
          "description": "The type of the validation rule.",
          "enum": [
            "required",
            "regex",
            "length",
            "range",
            "list"
          ],
          "type": "string"
        },
        "ruleValue": {
          "description": "The value of the validation rule.",
          "type": "string"
        }
      },
      "title": "Shipping Validation Rule",
      "type": "object"
    },
    "date-time": {
      "$id": "https://godaddy.com/schemas/common/date-time.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A date and time, in [Internet date and time format](https://tools.ietf.org/html/rfc3339#section-5.6). Note: The regular expression provides static schematic guidance but does not reject all invalid dates.",
      "maxLength": 64,
      "minLength": 20,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])[T,t]([0-1][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "link-description": {
      "$id": "https://godaddy.com/schemas/common/link-description.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A request-related [HATEOAS link](https://datatracker.ietf.org/doc/html/draft-handrews-json-schema-hyperschema-02).",
      "properties": {
        "href": {
          "description": "The complete target URL, or link, to use in combination with the method to make the related call, as defined by [RFC 6570 - URI Template](https://tools.ietf.org/html/rfc6570), with the addition of the `$`, `(`, and `)` characters for pre-processing. The `href` is the key HATEOAS component that links a completed call with a subsequent call.",
          "format": "uri",
          "type": "string"
        },
        "method": {
          "description": "The method to use to request the link target. For example, for HTTP, this might be `GET` or `DELETE`.",
          "type": "string"
        },
        "rel": {
          "description": "The [link relation type](https://tools.ietf.org/html/rfc5988#section-4), which is an identifier for a link that unambiguously describes the semantics of the link. For values, see [Link Relationship Types](https://www.iana.org/assignments/link-relations/link-relations.xhtml).",
          "type": "string"
        },
        "submissionMediaType": {
          "default": "application/json",
          "description": "The media type with which to submit data with the request.",
          "type": "string"
        },
        "submissionSchema": {
          "description": "The schema that describes the request data."
        },
        "targetMediaType": {
          "description": "The [RFC 2046-defined media type](https://www.ietf.org/rfc/rfc2046.txt) that describes the link target.",
          "type": "string"
        },
        "targetSchema": {
          "description": "The schema that describes the link target."
        },
        "title": {
          "description": "The link title.",
          "type": "string"
        }
      },
      "required": [
        "rel",
        "href"
      ],
      "title": "Link Description",
      "type": "object"
    }
  },
  "baseUrl": "https://api.godaddy.com",
  "description": "This API can be used for managing shipping",
  "endpoints": [
    {
      "description": "Find carriers and filter them using the criteria provided",
      "method": "GET",
      "operationId": "queryCarriers",
      "parameters": [
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true
        },
        {
          "description": "A non-negative, non-zero integer indicating the maximum number of resouces to return at one time",
          "in": "query",
          "name": "pageSize",
          "required": false,
          "schema": {
            "default": 25,
            "format": "int64",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Returns the resources that come after this specified cursor",
          "in": "query",
          "name": "pageToken",
          "required": false,
          "schema": {
            "description": "A cursor for use in pagination",
            "example": "MTY1MTc0NTczMDAwMDsyRzVWc1dFRmhJa3RIOFBZNHFDMGlPR0RwVko=",
            "type": "string"
          }
        },
        {
          "description": "Direction indicator used for cursor based pagination",
          "in": "query",
          "name": "pageTokenDirection",
          "required": false,
          "schema": {
            "default": "FORWARD",
            "description": "Page token direction",
            "enum": [
              "BACKWARD",
              "FORWARD"
            ],
            "type": "string"
          }
        }
      ],
      "path": "/v1/commerce/stores/{storeId}/shipping/carriers",
      "responses": {
        "200": {
          "description": "Successfully listed carriers",
          "schema": {
            "properties": {
              "carriers": {
                "items": {
                  "$ref": "#/$defs/Carrier"
                },
                "type": "array"
              },
              "links": {
                "description": "Array containing one or more HATEOAS link relations that are relevant for traversing carriers",
                "items": {
                  "$ref": "#/$defs/link-description"
                },
                "type": "array"
              },
              "status": {
                "description": "Status of the response",
                "example": "success",
                "type": "string"
              }
            },
            "required": [
              "status",
              "carriers",
              "links"
            ],
            "title": "Carriers",
            "type": "object"
          }
        },
        "401": {
          "description": "Authentication info not sent or is invalid",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "403": {
          "description": "Authenticated user is not allowed access",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "404": {
          "description": "Resource not found",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "409": {
          "description": "Application-specific server state error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "422": {
          "description": "Application-specific request error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "500": {
          "description": "Internal server error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "502": {
          "description": "Bad gateway or failed dependency",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "503": {
          "description": "Service is temporarily unavailable",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "504": {
          "description": "Gateway or dependency timeout",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        }
      },
      "scopes": [
        "commerce.carrier:read"
      ],
      "summary": "List all carriers"
    },
    {
      "description": "Create a new carrier",
      "method": "POST",
      "operationId": "createCarrier",
      "parameters": [
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true
        }
      ],
      "path": "/v1/commerce/stores/{storeId}/shipping/carriers",
      "requestBody": {
        "contentType": "application/json",
        "description": "The carrier object to create",
        "required": true,
        "schema": {
          "$ref": "#/$defs/Carrier"
        }
      },
      "responses": {
        "200": {
          "description": "Successfully created the carrier",
          "schema": {
            "properties": {
              "carrier": {
                "$ref": "#/$defs/Carrier"
              },
              "status": {
                "description": "Status of the response",
                "example": "success",
                "type": "string"
              }
            },
            "required": [
              "status",
              "carrier"
            ],
            "title": "CarrierCreated",
            "type": "object"
          }
        },
        "401": {
          "description": "Authentication info not sent or is invalid",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "403": {
          "description": "Authenticated user is not allowed access",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "404": {
          "description": "Resource not found",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "409": {
          "description": "Application-specific server state error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "422": {
          "description": "Application-specific request error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "500": {
          "description": "Internal server error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "502": {
          "description": "Bad gateway or failed dependency",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "503": {
          "description": "Service is temporarily unavailable",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "504": {
          "description": "Gateway or dependency timeout",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        }
      },
      "scopes": [
        "commerce.carrier:create"
      ],
      "summary": "Create a new carrier"
    },
    {
      "description": "Find a single carrier using the carrier ID.",
      "method": "GET",
      "operationId": "findCarrier",
      "parameters": [
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true
        }
      ],
      "path": "/v1/commerce/stores/{storeId}/shipping/carriers/{carrierId}",
      "responses": {
        "200": {
          "description": "Successfully found the carrier",
          "schema": {
            "properties": {
              "carrier": {
                "$ref": "#/$defs/Carrier"
              },
              "status": {
                "description": "Status of the response",
                "example": "success",
                "type": "string"
              }
            },
            "required": [
              "status",
              "carrier"
            ],
            "type": "object"
          }
        },
        "401": {
          "description": "Authentication info not sent or is invalid",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "403": {
          "description": "Authenticated user is not allowed access",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "404": {
          "description": "Resource not found",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "409": {
          "description": "Application-specific server state error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "422": {
          "description": "Application-specific request error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "500": {
          "description": "Internal server error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "502": {
          "description": "Bad gateway or failed dependency",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "503": {
          "description": "Service is temporarily unavailable",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "504": {
          "description": "Gateway or dependency timeout",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        }
      },
      "scopes": [
        "commerce.carrier:read"
      ],
      "summary": "Find a carrier"
    },
    {
      "description": "Find shipments and filter them using the criteria provided",
      "method": "GET",
      "operationId": "queryShipments",
      "parameters": [
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true
        },
        {
          "description": "A non-negative, non-zero integer indicating the maximum number of resouces to return at one time",
          "in": "query",
          "name": "pageSize",
          "required": false,
          "schema": {
            "default": 25,
            "format": "int64",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Returns the resources that come after this specified cursor",
          "in": "query",
          "name": "pageToken",
          "required": false,
          "schema": {
            "description": "A cursor for use in pagination",
            "example": "MTY1MTc0NTczMDAwMDsyRzVWc1dFRmhJa3RIOFBZNHFDMGlPR0RwVko=",
            "type": "string"
          }
        },
        {
          "description": "Direction indicator used for cursor based pagination",
          "in": "query",
          "name": "pageTokenDirection",
          "required": false,
          "schema": {
            "default": "FORWARD",
            "description": "Page token direction",
            "enum": [
              "BACKWARD",
              "FORWARD"
            ],
            "type": "string"
          }
        }
      ],
      "path": "/v1/commerce/stores/{storeId}/shipping/shipments",
      "responses": {
