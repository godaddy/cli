{
  "$defs": {
    "AmountType": {
      "$id": "https://godaddy.com/schemas/commerce/price-adjustments/enums/amount-type.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Possible ways to calculate the price adjustment amount; currently either a `PERCENTAGE` or `AMOUNT` is supported.\n- If the type is `AMOUNT`, the property `amount` in the request body is required.\n- If the type is `PERCENTAGE`, the property `ratePercentage` in the request body is required.\n",
      "enum": [
        "AMOUNT",
        "PERCENTAGE"
      ],
      "title": "AmountType",
      "type": "string"
    },
    "Error": {
      "properties": {
        "code": {
          "description": "The human-readable, unique name of the error.",
          "type": "string"
        },
        "message": {
          "description": "The message that describes the error.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExternalId": {
      "$id": "https://godaddy.com/schemas/commerce/price-adjustments/external-id.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "ExternalId is a unique identifier for a resource that is not managed by the PriceAdjustments service.\nFor example, an AvalaraId is an external id that is used to identify a tax code in Avalara.\n\nNOTE: this field has no current use in the PriceAdjustments service, but is included for use in future integrations.\n",
      "properties": {
        "type": {
          "description": "the type of the external id",
          "example": "AvalaraId",
          "type": "string"
        },
        "value": {
          "description": "the value of the external id",
          "example": "123456789",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ExternalId",
      "type": "object"
    },
    "PriceAdjustment": {
      "$id": "https://godaddy.com/schemas/commerce/price-adjustments/price-adjustment.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Price Adjustment Entity; contains all the information about a price adjustment",
      "properties": {
        "amount": {
          "$ref": "#/$defs/simple-money"
        },
        "amountType": {
          "$ref": "#/$defs/AmountType"
        },
        "appliedBeforeTax": {
          "description": "flag for if the price adjustment should be applied pre- or post- tax",
          "example": true,
          "type": "boolean"
        },
        "code": {
          "description": "Fee or discount code. Must be a unique code per store \n- two different stores are allowed to have the same code\n- the same store is not allowed to have two of the same code\n",
          "example": "holidays2023",
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/date-time"
        },
        "description": {
          "description": "The user friendly description of the price adjustment",
          "example": "15% off of drinks, 10% off of food",
          "type": "string"
        },
        "enabled": {
          "description": "flag for status of the price adjustment",
          "example": true,
          "type": "boolean"
        },
        "externalIds": {
          "description": "external ids for this price adjustment",
          "items": {
            "$ref": "#/$defs/ExternalId"
          },
          "type": "array"
        },
        "id": {
          "description": "A unique identifier for the price adjustment. Auto-generated on creation",
          "format": "uuid",
          "readOnly": true,
          "type": "string"
        },
        "metadata": {
          "items": {
            "$ref": "#/$defs/metafield"
          },
          "type": "array"
        },
        "name": {
          "description": "The user friendly name of the price adjustment",
          "example": "happy hour discount",
          "type": "string"
        },
        "ratePercentage": {
          "$ref": "#/$defs/percentage"
        },
        "storeId": {
          "description": "The storeId that this price adjustment belongs to",
          "format": "uuid",
          "readOnly": true,
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/PriceAdjustmentType"
        },
        "updatedAt": {
          "$ref": "#/$defs/date-time"
        }
      },
      "title": "PriceAdjustment",
      "type": "object"
    },
    "PriceAdjustmentAssociation": {
      "$id": "https://godaddy.com/schemas/commerce/price-adjustments/price-adjustment-association.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
