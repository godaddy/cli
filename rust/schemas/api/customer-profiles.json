{
  "$defs": {
    "ActionStatuses": {
      "description": "The possible statuses an action can be in",
      "enum": [
        "FAILED",
        "PARTIAL_SUCCESS",
        "PENDING",
        "SUCCESS"
      ],
      "type": "string"
    },
    "Address": {
      "properties": {
        "address1": {
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,100}$",
          "type": "string"
        },
        "address2": {
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,100}$",
          "type": "string"
        },
        "city": {
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,100}$",
          "type": "string"
        },
        "country": {
          "description": "Country ISO code",
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,2}$",
          "type": "string"
        },
        "label": {
          "description": "A descriptive name for the address",
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,100}$",
          "type": "string"
        },
        "postalCode": {
          "description": "Postal or zip code",
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,100}$",
          "type": "string"
        },
        "state": {
          "description": "State or province or territory",
          "maxLength": 100,
          "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,'#*@/& ]{,100}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Customer": {
      "allOf": [
        {
          "$ref": "#/$defs/CustomerBase"
        },
        {
          "$ref": "#/$defs/UpdatedAt"
        },
        {
          "$ref": "#/$defs/ListKeys"
        },
        {
          "properties": {
            "joined": {
              "default": false,
              "description": "Whether the customer has been joined with one or more other customers to create a single customer",
              "type": "boolean"
            },
            "orderCount": {
              "description": "Number of orders the customer has made",
              "minimum": 0,
              "type": "integer"
            },
            "paymentCount": {
              "description": "Number of payments the customer has completed",
              "minimum": 0,
              "type": "integer"
            },
            "profileImageUrl": {
              "description": "Url of the profile images for the customer",
              "format": "url",
              "type": "string"
            },
            "trackingDisabled": {
              "default": false,
              "description": "Whether the customer has opted out of tracking (eg. email opens and link clicks)",
              "type": "boolean"
            }
          },
          "required": [
            "customerId"
          ],
          "type": "object"
        }
      ]
    },
    "CustomerActionResponse": {
      "properties": {
        "links": {
          "items": {
            "properties": {
              "href": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "rel": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "links"
      ],
      "type": "object"
    },
    "CustomerAdmin": {
      "properties": {
        "customer": {
          "default": false,
          "description": "Whether or not the customer has completed transactions with the user",
          "type": "boolean"
        },
        "suppressed": {
          "default": false,
          "description": "Whether the customer is suppressed, due to opting out from email marketing, or their email address being unreachable",
          "type": "boolean"
        },
        "trackingDisabled": {
          "default": false,
          "description": "Whether the customer has opted out of tracking (eg. email opens and link clicks)",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "CustomerBase": {
      "allOf": [
        {
          "$ref": "#/$defs/CustomerId"
        },
        {
          "properties": {
            "addresses": {
              "default": [],
              "description": "Array of customer addresses. Note that currently only one address is supported",
              "items": {
                "$ref": "#/$defs/Address"
              },
              "maxLength": 10,
              "type": "array"
            },
            "emails": {
              "default": [],
              "description": "Array of email addresses",
              "items": {
                "$ref": "#/$defs/Email"
              },
              "maxLength": 10,
              "type": "array"
            },
            "firstName": {
              "example": "Fredrick",
              "maxLength": 50,
              "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,\\(\\)\\@&' ]*$",
              "type": "string"
            },
            "instantMessages": {
              "default": [],
              "description": "Array of instant messaging accounts associated with the customer",
              "items": {
                "$ref": "#/$defs/InstantMessage"
              },
              "maxLength": 10,
              "type": "array"
            },
            "jobTitle": {
              "type": "string"
            },
            "lastName": {
              "example": "Smith",
              "maxLength": 50,
              "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,\\(\\)\\@&' ]*$",
              "type": "string"
            },
            "nickname": {
              "description": "Name by which customer should be addressed",
              "example": "Fred",
              "maxLength": 50,
              "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,\\(\\)\\@&' ]*$",
              "type": "string"
            },
            "organization": {
              "example": "GoDaddy",
              "format": "organization-name",
              "maxLength": 100,
              "pattern": "^[\\u0080-\\uFFFFa-zA-Z0-9\\-.,\\(\\)\\\\@&!' +]*$",
              "type": "string"
            },
            "phones": {
              "default": [],
              "description": "Array of phone numbers",
              "items": {
                "$ref": "#/$defs/Phone"
              },
              "maxLength": 10,
              "type": "array"
            },
            "socialProfiles": {
              "default": [],
              "description": "Array of social profiles associated with the customer",
              "items": {
                "$ref": "#/$defs/SocialProfile"
              },
              "maxLength": 10,
              "type": "array"
            },
            "urls": {
              "default": [],
              "description": "Array of urls associated with the customer",
              "items": {
                "$ref": "#/$defs/Url"
              },
              "maxLength": 10,
              "type": "array"
            }
          },
          "required": [
            "firstName",
            "lastName",
            "email",
            "phone"
          ],
          "type": "object"
        }
      ]
    },
    "CustomerCreate": {
      "properties": {
        "customer": {
          "allOf": [
            {
              "$ref": "#/$defs/CustomerBase"
            },
            {
              "$ref": "#/$defs/CustomerAdmin"
            },
            {
              "$ref": "#/$defs/CustomerExternalIdentifier"
            },
            {
              "$ref": "#/$defs/ListKeys"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "customer",
        "source"
      ],
      "type": "object"
    },
    "CustomerDataPoint": {
      "properties": {
        "count": {
          "description": "Count of new unique customers",
          "format": "integer-positive",
          "type": "integer"
        },
        "periodEndedAt": {
          "$ref": "#/$defs/date-time"
        },
        "periodStartedAt": {
          "$ref": "#/$defs/date-time"
        }
      },
      "required": [
        "periodStartedAt",
        "periodEndedAt",
        "count"
      ],
      "type": "object"
    },
    "CustomerError": {
      "allOf": [
        {
          "$ref": "#/$defs/CustomerId"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ]
    },
    "CustomerExternalIdentifier": {
      "properties": {
        "externalIdentifier": {
          "properties": {
            "externalId": {
              "description": "The external id for the customer in another service",
              "maxLength": 255,
              "type": "string"
            },
            "source": {
              "description": "The name of service from which the external id originates",
              "example": "INVOICE",
              "maxLength": 255,
              "type": "string"
            }
          },
          "required": [
            "externalId",
            "source"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "CustomerId": {
      "description": "Customer identifier that is unique within current Store",
      "properties": {
        "customerId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "type": "object"
    },
    "CustomerId/properties/customerId": {
      "format": "uuid",
      "type": "string"
    },
    "CustomerUpdate": {
      "properties": {
        "customer": {
          "allOf": [
            {
              "$ref": "#/$defs/CustomerBase"
            },
            {
              "$ref": "#/$defs/CustomerAdmin"
            },
            {
              "$ref": "#/$defs/CustomerExternalIdentifier"
            },
            {
              "$ref": "#/$defs/ListKeys"
            },
            {
              "$ref": "#/$defs/UpdatedAt"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "customer",
        "source"
      ],
      "type": "object"
    },
    "Email": {
      "properties": {
        "default": {
          "description": "Indicates whether the email is the primary email.",
          "type": "boolean"
        },
        "email": {
          "$ref": "#/$defs/email-address"
        },
        "label": {
          "description": "A user provided name for the email address",
          "maxLength": 255,
          "type": "string"
        }
      },
      "required": [
        "email"
      ]
    },
    "Error": {
      "properties": {
        "code": {
          "description": "Short identifier for the error, suitable for indicating the specific error within client code",
          "format": "error-code",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "type": "string"
        },
        "fields": {
          "description": "List of the specific fields, and the errors found with their contents",
          "items": {
            "$ref": "#/$defs/ErrorField"
          },
          "minItems": 1,
          "type": "array"
        },
        "message": {
          "description": "Human-readable, English description of the error",
          "type": "string"
        },
        "stack": {
          "description": "Stack trace indicating where the error occurred.<br/>NOTE: This attribute <strong>MAY</strong> be included for Development and Test environments. However, it <strong>MUST NOT</strong> be exposed from OTE nor Production systems",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "code"
      ],
      "type": "object",
      "x-error-model": true
    },
    "ErrorField": {
      "properties": {
        "code": {
          "description": "Short identifier for the error, suitable for indicating the specific error within client code",
          "format": "error-code",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "type": "string"
        },
        "message": {
          "description": "Human-readable, English description of the error",
          "type": "string"
        },
        "path": {
          "description": "1) JSONPath referring to the field within the data containing an error<br/>or<br/>2) JSONPath referring to an object containing an error",
          "example": "$.activity",
          "format": "json-path",
          "pattern": "^[a-z_]([a-zA-Z0-9_.]*)*$",
          "type": "string"
        },
        "pathRelated": {
          "description": "JSONPath referring to the field on the object referenced by `path` containing an error",
          "example": "$.type",
          "format": "json-path",
          "pattern": "^[a-z_]([a-zA-Z0-9_.]*)*$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "code"
      ],
      "type": "object"
    },
    "ErrorLimit": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "retryAfterSec": {
              "description": "Number of seconds to wait before attempting a similar request",
              "format": "integer-positive",
              "pattern": "^[0-9]+$",
              "type": "integer"
            }
          },
          "required": [
            "retryAfterSec"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ],
      "x-error-model": true
    },
    "InstantMessage": {
      "properties": {
        "accountKey": {
          "description": "An accountKey for the instant messaging account",
          "maxLength": 255,
          "type": "string"
        },
        "label": {
          "description": "A user provided name for the external service",
          "maxLength": 255,
          "type": "string"
        }
      },
      "required": [
        "accountKey"
      ]
    },
    "ListKeys": {
      "properties": {
        "listKeys": {
          "description": "List memberships that should be changed for the customer",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "listKeys"
      ]
    },
    "PaginatedResponse": {
      "properties": {
        "links": {
          "description": "HATEOAS link relations",
          "items": {
            "$ref": "#/$defs/link-description"
          },
          "type": "array"
        },
        "totalItems": {
          "description": "The total number of items in the full result set. Only returned if the `totalRequired` param is true",
          "type": "integer"
        },
        "totalPages": {
          "description": "The total number of pages of results in the full result set. Only returned if the `totalRequired` param is true",
          "type": "integer"
        }
      },
      "required": [
        "links"
      ],
      "type": "object"
    },
    "Phone": {
      "properties": {
        "default": {
          "description": "Indicates whether the phone is the primary phone.",
          "type": "boolean"
        },
        "label": {
          "description": "A user provided name for the phone number",
          "maxLength": 255,
          "type": "string"
        },
        "phone": {
          "description": "A customer phone number",
          "format": "phone",
          "maxLength": 17,
          "type": "string"
        }
      },
      "required": [
        "phone"
      ],
      "type": "object"
    },
    "Request": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestId"
        },
        {
          "properties": {
            "customerIds": {
              "description": "IDs of the customer records affected - created or updated - by the request",
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            "errors": {
              "items": {
                "$ref": "#/$defs/CustomerError"
              },
              "type": "array"
            },
            "links": {
              "description": "HATEOAS link relations",
              "items": {
                "$ref": "#/$defs/link-description"
              },
              "type": "array"
            },
            "status": {
              "$ref": "#/$defs/ActionStatuses"
            },
            "undoSupport": {
              "description": "Whether or not the request can be undone automatically",
              "type": "boolean"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "RequestId": {
      "properties": {
        "requestId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "requestId"
      ],
      "type": "object"
    },
    "SocialProfile": {
      "properties": {
        "accountKey": {
          "description": "An accountKey for the social profile",
          "maxLength": 255,
          "type": "string"
        },
        "label": {
          "description": "A user provided name for the external service",
          "maxLength": 255,
          "type": "string"
        }
      },
      "required": [
        "accountKey"
      ]
    },
    "Source": {
      "description": "Source application of the interaction",
      "enum": [
        "COMMERCE",
        "CONVERSATIONS",
        "EMAIL_MARKETING",
        "GDSOCIAL",
        "GOPAY",
        "INVOICE",
        "POYNT",
        "ONLINE_APPOINTMENTS",
        "ONLINE_STORE",
        "PAYMENTS",
        "WEBSITE_BUILDER"
      ],
      "type": "string"
    },
    "UpdatedAt": {
      "properties": {
        "updatedAt": {
          "$ref": "#/$defs/date-time"
        }
      },
      "required": [
        "updatedAt"
      ],
      "type": "object"
    },
    "Url": {
      "properties": {
        "label": {
          "description": "A user provided name for the url",
          "maxLength": 255,
          "type": "string"
        },
        "url": {
          "description": "A url associated with the customer",
          "format": "url",
          "maxLength": 2083,
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "date-time": {
      "$id": "https://godaddy.com/schemas/common/date-time.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A date and time, in [Internet date and time format](https://tools.ietf.org/html/rfc3339#section-5.6). Note: The regular expression provides static schematic guidance but does not reject all invalid dates.",
      "maxLength": 64,
      "minLength": 20,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])[T,t]([0-1][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "email-address": {
      "$id": "https://godaddy.com/schemas/common/email-address.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A valid, internationalized email address. Note: Up to 64 characters are allowed before and 255 characters are allowed after the @ sign. However, the generally accepted maximum length for an email address is 254 characters. The pattern verifies that an unquoted @ sign exists.",
      "maxLength": 254,
      "minLength": 3,
      "pattern": "^.+@[^\"\\-].+$",
      "type": "string"
    },
    "link-description": {
      "$id": "https://godaddy.com/schemas/common/link-description.v1",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A request-related [HATEOAS link](https://datatracker.ietf.org/doc/html/draft-handrews-json-schema-hyperschema-02).",
      "properties": {
        "href": {
          "description": "The complete target URL, or link, to use in combination with the method to make the related call, as defined by [RFC 6570 - URI Template](https://tools.ietf.org/html/rfc6570), with the addition of the `$`, `(`, and `)` characters for pre-processing. The `href` is the key HATEOAS component that links a completed call with a subsequent call.",
          "format": "uri",
          "type": "string"
        },
        "method": {
          "description": "The method to use to request the link target. For example, for HTTP, this might be `GET` or `DELETE`.",
          "type": "string"
        },
        "rel": {
          "description": "The [link relation type](https://tools.ietf.org/html/rfc5988#section-4), which is an identifier for a link that unambiguously describes the semantics of the link. For values, see [Link Relationship Types](https://www.iana.org/assignments/link-relations/link-relations.xhtml).",
          "type": "string"
        },
        "submissionMediaType": {
          "default": "application/json",
          "description": "The media type with which to submit data with the request.",
          "type": "string"
        },
        "submissionSchema": {
          "description": "The schema that describes the request data."
        },
        "targetMediaType": {
          "description": "The [RFC 2046-defined media type](https://www.ietf.org/rfc/rfc2046.txt) that describes the link target.",
          "type": "string"
        },
        "targetSchema": {
          "description": "The schema that describes the link target."
        },
        "title": {
          "description": "The link title.",
          "type": "string"
        }
      },
      "required": [
        "rel",
        "href"
      ],
      "title": "Link Description",
      "type": "object"
    }
  },
  "baseUrl": "https://api.godaddy.com/v1/commerce",
  "description": "This API can be used to retrieve, create, update and delete customers as well as customer information.",
  "endpoints": [
    {
      "description": "This endpoint can be used to create an actvity for a specific customer using the store ID. Customer activities are the series of actions a customer can perform such as orders, bookings, and payments, which can be tracked for further analysis. Customer data will only be added when the customer does not yet exist.",
      "method": "POST",
      "operationId": "commerceCustomerCreateActivity",
      "parameters": [
        {
          "description": "An identifier for a store",
          "in": "path",
          "name": "storeId",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "path": "/stores/{storeId}/customer-activities",
      "requestBody": {
        "contentType": "application/json",
        "description": "Activity and contact data",
        "required": true,
        "schema": {
          "properties": {
            "activity": {
              "description": "Data about the activity",
              "properties": {
                "source": {
                  "$ref": "#/$defs/Source"
                },
                "type": {
                  "description": "The type of activity to associate with the customer",
                  "enum": [
                    "BOOKING_CLAIMED",
                    "BOOKING_CREATED",
                    "BOOKING_RESCHEDULED",
                    "ORDER_CREATED",
                    "PAYMENT_COMPLETED",
                    "PAYMENT_REFUNDED",
                    "PAYMENT_VOIDED"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "source",
                "type"
              ],
              "type": "object"
            },
            "customer": {
              "allOf": [
                {
                  "$ref": "#/$defs/CustomerBase"
                },
                {
                  "$ref": "#/$defs/CustomerExternalIdentifier"
                },
                {
                  "$ref": "#/$defs/ListKeys"
                }
              ],
              "description": "Customer data regarding the customer who performed the activity. Customer data will only be added when the customer does not yet exist.",
              "type": "object"
            }
          },
          "required": [
            "activity",
            "customer"
          ],
          "type": "object"
        }
      },
      "responses": {
        "204": {
          "description": "An activity for the given contact has been created"
        },
        "401": {
          "description": "Authentication info not sent or is invalid",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "403": {
          "description": "Authenticated user is not allowed access",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "404": {
          "description": "Resource not found",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "409": {
          "description": "Application-specific server state error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "422": {
          "description": "Application-specific request error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        },
        "500": {
          "description": "Internal server error",
          "schema": {
            "$ref": "#/$defs/Error"
          }
        }
      },
      "scopes": [
        "commerce.customer:create"
      ],
      "summary": "Create customer activity"
    },
    {
      "description": "This endpoint can be used to combine two or more customers together to create a single customer. The customer with the most complete basic attributes such as name, organization, and job title will be selected as the primary customer, and any attributes from the other customers will be reverse merged into the primary customer.",
      "method": "POST",
      "operationId": "CommerceCustomerJoin",
      "parameters": [
        {
          "description": "An identifier for a store",
          "in": "path",
