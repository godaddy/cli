      "minProperties": 1,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9 _.'&(),!#:+/-]*$",
          "type": "string"
        },
        "rootPath": {
          "maxLength": 2048,
          "type": "string"
        }
      },
      "type": "object"
    },
