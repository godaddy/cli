              "createdAt",
              "updatedAt"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "hasMore": {
          "type": "boolean"
        },
        "totalCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "deployments",
        "totalCount",
        "hasMore"
      ],
      "type": "object"
    },
    "PublicPatchAppBody": {
      "additionalProperties": false,
