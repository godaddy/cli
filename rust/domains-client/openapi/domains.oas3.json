                        "in": "query",
                        "name": "sources",
                        "required": false,
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "enum": [
                                    "CC_TLD",
                                    "EXTENSION",
                                    "KEYWORD_SPIN",
                                    "PREMIUM",
                                    "cctld",
                                    "keywordspin"
