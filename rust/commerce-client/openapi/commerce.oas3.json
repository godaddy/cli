  "info": {
    "description": "This API is capable of recording, updating and retrieving store information",
    "title": "Commerce Store API",
    "version": "2.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v2/commerce/stores": {
      "get": {
        "description": "Retrieve the list of stores associated with a Business ID",
        "operationId": "getStoresByBusinessId",
        "parameters": [
          {
            "description": "Business ID",
            "in": "query",
            "name": "businessId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/uuid"
            }
          },
          {
            "description": "To check if data has been modified since a given date",
            "in": "header",
            "name": "If-Modified-Since",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 10,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "totalRequired",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "List of fields to include in the response",
            "example": "address,attributes",
            "explode": false,
            "in": "query",
            "name": "includeFields",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoreList"
                }
              }
            },
            "description": "List of stores found",
            "headers": {
              "X-Request-Id": {
                "deprecated": true,
                "description": "Request Id",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:create"
            ]
          }
        ],
        "summary": "Get stores by business ID",
        "tags": [
          "General Endpoints"
        ]
      },
      "parameters": [
        {
          "description": "Request ID",
          "in": "header",
          "name": "X-Request-Id",
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Create a new store",
        "operationId": "createStore",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Store"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Store"
                }
              }
            },
            "description": "Store Created",
            "headers": {
              "Location": {
                "description": "Location of the resource",
                "schema": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "deprecated": true,
                "description": "Request Id",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:create"
            ]
          }
        ],
        "summary": "Create a new store",
        "tags": [
          "General Endpoints"
        ]
      }
    },
    "/v2/commerce/stores/{storeId}": {
      "get": {
        "description": "Retrieve the information of a store using the Business and Store IDs.",
        "operationId": "getStoreById",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Store"
                }
              }
            },
            "description": "Store Found",
            "headers": {
              "X-Request-Id": {
                "deprecated": true,
                "description": "Request Id",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:read"
            ]
          }
        ],
        "summary": "Get store by ID",
        "tags": [
          "General Endpoints"
        ]
      },
      "parameters": [
        {
          "description": "Request ID",
          "in": "header",
          "name": "X-Request-Id",
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/uuid"
          }
        },
        {
          "description": "List of fields to include in the response",
          "example": "address,attributes",
          "explode": false,
          "in": "query",
          "name": "includeFields",
          "required": false,
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "style": "form"
        }
      ],
      "patch": {
        "description": "Update the details of a store using the storeId.",
        "operationId": "updateStore",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/patch-request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Store"
                }
              }
            },
            "description": "Store updated"
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:update"
            ]
          }
        ],
        "summary": "Update store information",
        "tags": [
          "General Endpoints"
        ]
      }
    },
    "/v2/commerce/stores/{storeId}/attributes/{attrName}": {
      "delete": {
        "description": "Delete a store attribute using the store ID and attribute name.",
        "operationId": "deleteStoreAttribute",
        "parameters": [
          {
            "description": "Attribute name",
            "in": "path",
            "name": "attrName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Store Attribute deleted"
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:update"
            ]
          }
        ],
        "summary": "Delete store attribute"
      },
      "get": {
        "description": "Retrieve the information of a store attribute using the business ID, store ID and attribute name.",
        "operationId": "getStoreAttribute",
        "responses": {
          "200": {
            "description": "Store Attribute Found",
            "headers": {
              "X-Request-Id": {
                "deprecated": true,
                "description": "Request Id",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:read"
            ]
          }
        ],
        "summary": "Get store attribute",
        "tags": [
          "General Endpoints"
        ]
      },
      "parameters": [
        {
          "description": "Request ID",
          "in": "header",
          "name": "X-Request-Id",
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/uuid"
          }
        },
        {
          "description": "Attribute name",
          "in": "path",
          "name": "attrName",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "description": "Modify the attribute of a store using the store ID and attribute name.",
        "operationId": "updateStoreAttribute",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/attributeUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Store Attribute updated"
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:update"
            ]
          }
        ],
        "summary": "Update store attribute",
        "tags": [
          "General Endpoints"
        ]
      }
    },
    "/v2/commerce/stores/{storeId}/government-ids": {
      "parameters": [
        {
          "description": "Request ID",
          "in": "header",
          "name": "X-Request-Id",
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Store ID",
          "in": "path",
          "name": "storeId",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      ],
      "put": {
        "description": "Update government IDs using the store ID.",
        "operationId": "updateGovernmentIds",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/governmentIdList"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Store"
                }
              }
            },
            "description": "Government IDs updated"
          }
        },
        "security": [
          {
            "Oauth2": [
              "commerce.store:update"
            ]
          }
        ],
        "summary": "Update government IDs",
        "tags": [
          "General Endpoints"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://api.{sub-domain}.com/{version}/{namespace}",
      "variables": {
        "namespace": {
          "default": "commerce",
          "description": "Namespace"
        },
        "sub-domain": {
          "default": "godaddy",
          "description": "Sub domain for different environments",
          "enum": [
            "godaddy",
            "ote-godaddy",
            "test-godaddy",
            "dev-godaddy"
          ]
        },
        "version": {
          "default": "v2",
          "description": "Version"
        }
      }
    }
  ]
}